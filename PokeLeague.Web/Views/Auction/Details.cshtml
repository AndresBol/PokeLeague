@model PokeLeague.Application.DTOs.AuctionDTO

@{
    ViewData["Title"] = "Auction Detail";
    var imageCount = Model.Card.Image.Count;
    var canEditOrCancel = Model.Status == "Scheduled" && Model.AuctionBid.Count == 0;
}

<div class="d-flex flex-row align-items-center justify-content-between">
    <h2>Auction Detail</h2>
    @if (canEditOrCancel)
    {
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-success"><i class="bi bi-pencil"></i> Edit Auction</a>
            <form id="cancelForm" asp-action="Cancel" asp-route-id="@Model.Id" method="post">
                <button type="button" class="btn btn-danger" onclick="confirmCancel()"><i class="bi bi-x-circle"></i> Cancel Auction</button>
            </form>
        </div>
    }
</div>

<div class="container-sm mb-2">

    <h3>@Html.DisplayFor(model => model.Card.Name)</h3>

    <div class="container-lg d-flex flex-column flex-lg-row justify-content-between align-items-start mt-5">
        <dl class="row">
            <dt class = "col-sm-4 h5 text-nowrap">
                Categories:
            </dt>
            <dd class="col-sm-8 text-nowrap">
                @foreach(var category in Model.Card.CategoryCard)
                {
                    <div class="chip secondary me-1">
                        @category.Category.Name
                    </div>
                }
            </dd>
            <dt class="col-sm-4 h5 text-nowrap">
                Condition:
            </dt>
            <dd class = "col-sm-8">
                <div class="chip @(Model.Card.IsNew ? "success" : "warning")">
                    @(Model.Card.IsNew ? "New" : "Used")
                </div>
            </dd>
            <dt class="col-sm-4 h5 text-nowrap">
                Start Date:
            </dt>
            <dd class = "col-sm-8">
                @Model.StartDate.ToString("dd MMM yyyy hh:mm tt")
            </dd>
            <dt class="col-sm-4 h5 text-nowrap">
                End Date:
            </dt>
            <dd class = "col-sm-8">
                @Model.EndDate.ToString("dd MMM yyyy hh:mm tt")
            </dd>
            <dt class="col-sm-4 h5 text-nowrap">
                Base Price:
            </dt>
            <dd class = "col-sm-8">
                $@Model.BasePrice
            </dd>
            <dt class="col-sm-4 h5 text-nowrap">
                Min Increase:
            </dt>
            <dd class = "col-sm-8">
                $@Model.MinIncrease
            </dd>

            <dt class = "col-sm-4 h5 text-nowrap">
                Current Status:
            </dt>
            <dd class = "col-sm-8">
                @{
                    var statusClass = Model.Status switch
                    {
                        "In Progress" => "success",
                        "Finished" => "secondary",
                        "Canceled" => "danger",
                            _=> "warning"
                    };
                }
                <div class="chip @statusClass">
                    @Model.Status
                </div>
              </dd>

            <dt class="col-sm-4 h5 text-nowrap">
               Total Bids:
            </dt>
            <dd class="col-sm-8">
                <span class="badge bg-primary fs-6">
                    @Model.AuctionBid.Count
                </span>
            </dd>

            <h5 class="mb-3">
                Current Price:
                <span id="currentPrice" class="text-success fw-bold">
                    $@(Model.AuctionBid.Any()
                    ? Model.AuctionBid.Max(b => b.BidAmount)
                    : Model.BasePrice)
                </span>
            </h5>

            <div class="mt-4 p-3 border rounded bg-light" style="max-width: 350px;">

                <label for="bidAmount" class="form-label fw-bold">
                    Place your bid
                </label>

                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input type="number" id="bidAmount" class="form-control" placeholder="Enter amount" />
                </div>

                <button id="btnBid"  class="btn btn-primary w-100 mt-3">
                    <i class="bi bi-cash-coin me-2"></i>
                    Place Bid
                </button>

            </div>

            <div class="mt-4">
                <a asp-action="Bids"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-primary">
                    View Bid History
                </a>
            </div>


            </dl>

            <div id="carouselCard@(Model.Id)Images" class="carousel slide" data-bs-ride="carousel" style="width: 385px;">
                <div class="carousel-indicators">
                    @for (int i = 0; i < imageCount && imageCount > 1; i++)
                    {
                        <button type="button" data-bs-target="#carouselCard@(Model.Id)Images" data-bs-slide-to="@i" class="active" aria-current="true" aria-label="Slide @(i + 1)"></button>
                    }
                </div>
                <div class="carousel-inner">
                    @foreach (var image in Model.Card.Image)
                    {
                        <div class="carousel-item @(image.Id == Model.Card.Image.First().Id ? "active" : "")">
                            <img src="data:image/jpeg;base64,@Convert.ToBase64String(image.ImageData)"
                             style="width: 385px; height: auto; max-height: 450px; flex-grow: 0; flex-shrink: 0;"
                                 loading="lazy" alt="@Model.Card.Name Image">
                        </div>
                    }
                </div>
                @if (imageCount > 1)
                {
                    <button class="carousel-control-prev" type="button" data-bs-target="#carouselCard@(Model.Id)Images" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#carouselCard@(Model.Id)Images" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                }
          </div>
    </div>

    <div class="mt-5">
        <h4>Latest Bids</h4>

        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th>User</th>
                    <th class="text-center">Amount</th>
                    <th class="text-center">Date</th>
                </tr>
            </thead>

            <tbody id="bidsTable">
                @foreach (var bid in Model.AuctionBid
                .OrderByDescending(b => b.BidDate)
                .Take(5))
                {
                    <tr>
                        <td>@bid.User.Username</td>
                        <td class="text-center">$ @bid.BidAmount</td>
                        <td class="text-center">
                            @bid.BidDate.ToString("dd/MM/yyyy HH:mm")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="d-flex flex-column align-items-start justify-content-end my-5 mx-2">
    <a asp-action="Index" class="btn btn-secondary align-items-center"><h3><i class="bi bi-arrow-return-left me-3"></i>Back to list</h3></a>
</div>

@section Scripts {
    <script>
        function confirmCancel() {
            Swal.fire({
                title: 'Are you sure you want to cancel this auction?',
                text: "This action cannot be undone.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, cancel it!',
                cancelButtonText: 'No, go back'
            }).then((result) => {
                if (result.isConfirmed) {
                    var form = document.getElementById('cancelForm');
                    form.submit();
                }
            });
        }

        function formatDate(date){

            const day = String(date.getDate()).padStart(2,'0');
            const month = String(date.getMonth()+1).padStart(2,'0');
            const year = date.getFullYear();

            const hours =String(date.getHours()).padStart(2,'0');
            const minutes = String(date.getMinutes()).padStart(2, '0');

            return `${day}/${month}/${year} ${hours}:${minutes}`;
        }
     
        document.getElementById("btnBid").addEventListener("click", async ()=> {

            const amount = document.getElementById("bidAmount").value;
            const numericAmount = parseFloat(amount);

            const currentPriceText = document.getElementById("currentPrice").innerText;
            const currentPrice = parseFloat(currentPriceText.replace("$", "").trim());

            if(!amount || numericAmount <= 0){
                Swal.fire({
                    icon:'warning',
                    title: 'Invalid amount',
                    text: 'Please enter a valid bid.'
                });
                return;
            }

            if(numericAmount <= currentPrice){
                Swal.fire({
                    icon:'warning',
                    title: 'Bid too low',
                    text: `Your bid must be higher than $${currentPrice}`
                });
                return;
            }

            const auctionId = @(Model.Id);

            const data ={
                auctionId:auctionId,
                userId:2,
                bidAmount: numericAmount
            };
          const btn = document.getElementById("btnBid");
          btn.disabled = true;
            try
            {
                const response = await fetch('/Auction/CreateBid',{
                    method: 'POST',
                    headers:{
                        'Content-Type': 'application/json'
                    },
                    body:JSON.stringify(data)
                });

               
                const result = await response.json();

                console.log("RESULT:", result);

                if(result.success){
                    const bid = result.data;

                Swal.fire({
                   icon:'success',
                   title:'Bid placed!',
                   text:'Your bid was successful.'
                });
                    document.getElementById("currentPrice").innerText = `$ ${bid.bidAmount.toFixed(2)}`;

                    document.getElementById("bidAmount").value = "";

                        const table = document.getElementById("bidsTable");

                        const formattedAmount = bid.bidAmount.toFixed(2);
                        const formattedDate = formatDate(new Date(bid.bidDate));

                        const newRow = `
                    <tr class="new-bid" data-id="${bid.id}">
                    <td>${bid.username}</td>
                     <td class="text-center">$ ${formattedAmount}</td>
                      <td class="text-center">
                     ${formattedDate}
                </td>
            </tr>
        `;

        const exists = table.querySelector(`tr[data-id="${bid.id}"]`);

        if(!exists){
        table.insertAdjacentHTML("afterbegin", newRow);

        }

        const firstRow= table.querySelector("tr");
        firstRow.scrollIntoView({behavior:"smooth"});


                } else{
                 Swal.fire({
                   icon:'error',
                   title:'Error',
                   text:'Could not place bid.'
                });
                }
                
            }catch(error){
                Swal.fire({
                   icon:'error',
                   title:'Connection error',
                   text:'Something went wrong.'
                });
            } finally{

                 btn.disabled = false;
            }
        });


    
    </script>
}
