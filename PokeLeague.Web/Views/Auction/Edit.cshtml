@model PokeLeague.Application.DTOs.AuctionDTO

@{
    ViewData["Title"] = "Edit";
}


<h1>Edit Auction</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="CardId" />
            <input type="hidden" asp-for="IsActive" />
            <input type="hidden" asp-for="IsCanceled" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="StartDate" class="control-label"></label>
                <div class="d-flex gap-2">
                    <input type="date" id="StartDateDate" class="form-control" />
                    <input type="time" id="StartDateTime" class="form-control" />
                </div>
                <input type="hidden" asp-for="StartDate" />
                <span id="StartDateFieldError" class="text-danger"></span>
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EndDate" class="control-label"></label>
                <div class="d-flex gap-2">
                    <input type="date" id="EndDateDate" class="form-control" />
                    <input type="time" id="EndDateTime" class="form-control" />
                </div>
                <input type="hidden" asp-for="EndDate" />
                <span id="EndDateFieldError" class="text-danger"></span>
                <span id="endDateError" class="text-danger"></span>
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BasePrice" class="control-label"></label>
                <input asp-for="BasePrice" type="number" step="0.10" class="form-control" />
                <span asp-validation-for="BasePrice" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MinIncrease" class="control-label"></label>
                <input asp-for="MinIncrease" type="number" step="0.10" class="form-control" />
                <span asp-validation-for="MinIncrease" class="text-danger"></span>
            </div>
            <div class="form-group d-flex flex-column align-items-stretch justify-content-center mt-4">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="d-flex flex-column align-items-start justify-content-end my-5 mx-2">
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary align-items-center"><h3><i class="bi bi-arrow-return-left me-3"></i>Back to Detail</h3></a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        const endDateError = document.getElementById("endDateError");

        function syncDateTime(prefix) {
            const date = document.getElementById(`${prefix}Date`).value;
            const time = document.getElementById(`${prefix}Time`).value;
            if (date && time) {
                document.getElementById(prefix).value = `${date}T${time}`;
            } else {
                document.getElementById(prefix).value = '';
            }
            validateDateTimeFields(prefix);
            validateEndDate();
        }

        function validateDateTimeFields(prefix) {
            const date = document.getElementById(`${prefix}Date`).value;
            const time = document.getElementById(`${prefix}Time`).value;
            const errorSpan = document.getElementById(`${prefix}FieldError`);

            if (!date && !time) {
                errorSpan.textContent = "";
                return true;
            }
            if (!date) {
                errorSpan.textContent = "Please select a date.";
                return false;
            }
            if (!time) {
                errorSpan.textContent = "Please select a time.";
                return false;
            }

            errorSpan.textContent = "";
            return true;
        }

        function validateEndDate() {
            const start = document.getElementById("StartDate").value;
            const end = document.getElementById("EndDate").value;

            if (start && end && new Date(end) <= new Date(start)) {
                endDateError.textContent = "End date must be after start date.";
                return false;
            }

            endDateError.textContent = "";
            return true;
        }

        const dateTimeFields = ["StartDate", "EndDate"];
        for (const prefix of dateTimeFields) {
            document.getElementById(`${prefix}Date`).addEventListener("change", () => syncDateTime(prefix));
            document.getElementById(`${prefix}Time`).addEventListener("change", () => syncDateTime(prefix));
        }

        // Pre-populate date/time fields from existing model values
        const pad = (n) => String(n).padStart(2, '0');

        function populateFromModel(prefix, isoValue) {
            if (!isoValue) return;
            const dt = new Date(isoValue);
            if (isNaN(dt)) return;
            const dateStr = `${dt.getFullYear()}-${pad(dt.getMonth() + 1)}-${pad(dt.getDate())}`;
            const timeStr = `${pad(dt.getHours())}:${pad(dt.getMinutes())}`;
            document.getElementById(`${prefix}Date`).value = dateStr;
            document.getElementById(`${prefix}Time`).value = timeStr;
            syncDateTime(prefix);
        }

        populateFromModel("StartDate", "@Model.StartDate.ToString("o")");
        populateFromModel("EndDate", "@Model.EndDate.ToString("o")");

        document.querySelector('form').addEventListener("submit", async function (e) {
            e.preventDefault();

            let isValid = true;

            for (const prefix of dateTimeFields) {
                if (!validateDateTimeFields(prefix)) {
                    isValid = false;
                }
                const hiddenValue = document.getElementById(prefix).value;
                if (!hiddenValue) {
                    const errorSpan = document.getElementById(`${prefix}FieldError`);
                    if (!errorSpan.textContent) {
                        errorSpan.textContent = "Please select both a date and a time.";
                    }
                    isValid = false;
                }
            }

            if (!validateEndDate()) {
                isValid = false;
            }

            if (isValid) {
                this.submit();
            }
        });
    </script>
}
