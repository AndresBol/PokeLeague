@model IEnumerable<PokeLeague.Application.DTOs.AuctionDTO>

<div class="d-flex justify-content-between align-items-center">
    <h3>Auctions</h3>
    @{
        /*TODO: <a asp-controller="Auction" asp-action="Create" class="btn btn-primary" role="button">Create</a>*/
    }
</div>
<table class="table table-striped table-hover table-bordered">
    <thead>
        <tr>
            <th class="text-center" scope="col">
                #
            </th>
            <th scope="col">
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th scope="col">
                @Html.DisplayNameFor(model => model.StartDate)
            </th>
            <th scope="col">
                @Html.DisplayNameFor(model => model.EndDate)
            </th>
            <th class="text-center" scope="col">
                @Html.DisplayNameFor(model => model.Status)
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr onclick="location.href='@Url.Action("Details", "Auction", new { id = item.Id })'" style="cursor: pointer;">
                <td class="text-center" scope="row">
                    @(Model.ToList().IndexOf(item) + 1)
                </td>
                <td>
                    #@Html.DisplayFor(modelItem => item.Id)
                </td>
                <td>
                    @item.StartDate.ToString("dd/MM/yyyy HH:mm")
                </td>
                <td>
                    @item.EndDate.ToString("dd/MM/yyyy HH:mm")
                </td>
                
                <td class="text-center">
                @{
                    var statusClass = item.Status switch
                    {
                        "Canceled" => "danger",
                        "Scheduled" => "secondary",
                        "In Progress" => "warning",
                        _ => "success"
                    };
                }
                <div class="chip @statusClass">@item.Status</div>
                </td>
            </tr>
        }
    </tbody>
</table>