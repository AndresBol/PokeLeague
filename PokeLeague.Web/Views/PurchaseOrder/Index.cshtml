@model IEnumerable<PokeLeague.Application.DTOs.PurchaseOrderDTO>

@{
    ViewData["Title"] = "Payment History";
}

<div class="d-flex flex-row align-items-center justify-content-between">
    <h2 class="mb-4">Payment History</h2>
</div>

<table class="table table-striped table-hover table-bordered">
    <thead>
        <tr>
            <th class="text-center" scope="col">#</th>
            <th scope="col">Card</th>
            <th scope="col">Buyer</th>
            <th class="text-center" scope="col">Amount</th>
            <th class="text-center" scope="col">Payment Date</th>
            <th class="text-center" scope="col">Status</th>
        </tr>
    </thead>
    <tbody>
        @{ int index = 1; }
        @foreach (var item in Model)
        {
            <tr onclick="location.href='@Url.Action("Details", new { id = item.Id })'" style="cursor: pointer;">
                <td class="text-center" scope="row">@(index++)</td>
                <td>
                    <div class="d-flex align-items-center gap-2">
                        @{
                            var thumb = item.Auction?.Card?.Image?.FirstOrDefault(i => i.IsActive);
                        }
                        @if (thumb != null && thumb.ImageData.Length > 0)
                        {
                            <img src="data:image/jpeg;base64,@Convert.ToBase64String(thumb.ImageData)"
                                 alt="@item.Auction.Card.Name"
                                 style="width: 45px; height: 45px; object-fit: cover; border-radius: 6px;"
                                 loading="lazy" />
                        }
                        <span>@item.Auction?.Card?.Name</span>
                    </div>
                </td>
                <td>@item.User?.Username</td>
                <td class="text-center">$@item.PurchaseAmount</td>
                <td class="text-center">@item.PaymentDate.ToString("dd MMM yyyy hh:mm tt")</td>
                <td class="text-center">
                    @if (item.Status == "Confirmed")
                    {
                        <span class="badge bg-success">Confirmed</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Pending</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info text-center mt-3">
        <i class="bi bi-info-circle me-2"></i> No payments registered yet.
    </div>
}
