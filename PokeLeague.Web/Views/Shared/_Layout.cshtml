@{
    bool IsSelectedAction(string controller, string action)
    {
        return ViewContext.RouteData.Values["controller"]?.ToString() == controller && ViewContext.RouteData.Values["action"]?.ToString() == action;
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PokeLeague.Web.styles.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-toggleable-md navbar-light bg-white border-bottom box-shadow align-items-baseline mb-3 p-3 gap-1">
            <div class="d-flex flex-row align-items-center justify-content-between flex-nowrap flex-grow-1 flex-md-grow-0">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index"><img style="max-height: 65px; width: fit-content;" class="img-fluid" src="~/media/light/imagotipo.png" /></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>
            <div class="navbar-collapse collapse d-md-inline-flex justify-content-between flex-grow-1">
                <ul class="navbar-nav flex-grow-1 gap-2 h5">
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(IsSelectedAction("User", "Index") ? "border-bottom border-warning border-2 text-dark" : "")" asp-area="" asp-controller="user" asp-action="Index"><i class="bi bi-people-fill me-1"></i> Users</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(IsSelectedAction("Report", "Index") ? "border-bottom border-warning border-2 text-dark" : "")" asp-area="" asp-controller="Report" asp-action="Index"><i class="bi bi-bar-chart-line me-1"></i> Reports</a>
                        </li>
                    }
                    @if (User.IsInRole("Admin") || User.IsInRole("Seller"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(IsSelectedAction("Card", "Index") ? "border-bottom border-warning border-2 text-dark" : "")" asp-area="" asp-controller="card" asp-action="Index"><i class="bi bi-card-heading me-1"></i> Cards</a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link @(IsSelectedAction("Auction", "Index") ? "border-bottom border-warning border-2 text-dark" : "")" asp-area="" asp-controller="Auction" asp-action="Index"><i class="bi bi-briefcase-fill me-1"></i> Auctions</a>
                    </li>
                    @if (User.IsInRole("Admin") || User.IsInRole("Buyer"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(IsSelectedAction("PurchaseOrder", "Index") ? "border-bottom border-warning border-2 text-dark" : "")" asp-area="" asp-controller="PurchaseOrder" asp-action="Index"><i class="bi bi-credit-card me-1"></i> Payments</a>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav ms-auto gap-2 align-items-center">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="User" asp-action="EditProfile"><i class="bi bi-person-fill me-1"></i>@User.Identity.Name</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-danger" asp-controller="Login" asp-action="LogOff"><i class="bi bi-box-arrow-right me-1"></i> Log Out</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Login" asp-action="Index"><i class="bi bi-box-arrow-in-right me-1"></i> Login</a>
                        </li>
                    }
                </ul>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="d-flex flex-column-reverse flex-sm-row justify-content-around align-items-center">
            <span>&copy; 2026 - PokeLeague</span>
            <span>Developers: Andrés Bolaños & Josué Calderón</span>
        </div>
    </footer>
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/js/tom-select.complete.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    @if (TempData["Notification"] != null)
    {
        <script>
            var config = @Html.Raw(TempData["Notification"]);
            Swal.fire(config);
        </script>
    }
    @if (ViewBag.Notification != null)
    {
        <script>
            var config = @Html.Raw(ViewBag.Notification);
            Swal.fire(config);
        </script>
    }
</body>
</html>
