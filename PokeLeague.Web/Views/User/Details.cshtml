@model PokeLeague.Application.DTOs.UserDTO

@{
    ViewData["Title"] = Model.Username;
}


<div class="container-sm mb-2">
    <div class="container-lg d-flex flex-row flex-md-row-reverse align-items-center justify-content-start justify-content-md-between flex-wrap my-2 gap-4">
        <img class="my-2 userLogo" src="~/media/User.svg" />
        <h2>@Html.DisplayFor(model => model.Username)</h2>
    </div>
    <hr />
    <div class="container-lg d-flex flex-column flex-md-row justify-content-between">
        <dl class="row">
            <dt class="col-sm-4 h5 text-nowrap">
                @Html.DisplayNameFor(model => model.Email):
            </dt>
            <dd class="col-sm-8 text-nowrap">
                @Html.DisplayFor(model => model.Email)
            </dd>
            <dt class="col-sm-4 h5 text-nowrap">
                @Html.DisplayNameFor(model => model.Role.Name):
            </dt>
            <dd class="col-sm-8 text-nowrap">
                @Html.DisplayFor(model => model.Role.Name)
            </dd>
            <dt class="col-sm-4 h5 text-nowrap">
                @Html.DisplayNameFor(model => model.SignupDate):
            </dt>
            <dd class="col-sm-8 text-nowrap">
                @Html.DisplayFor(model => model.SignupDate)
            </dd>
            <dt class="col-sm-4 h5 text-nowrap">
                Created Auctions:
            </dt>
            <dd class="col-sm-8 text-nowrap">
                @Html.DisplayFor(model => model.Auction.Count)
            </dd>
            <dt class="col-sm-4 h5 text-nowrap">
                Registered Bids:
            </dt>
            <dd class="col-sm-8 text-nowrap">
                @Html.DisplayFor(model => model.AuctionBid.Count)
            </dd>

        </dl>
        <div class="d-flex flex-column justify-content-start align-items-stretch">
            <h5 class="text-nowrap">@Html.DisplayNameFor(model => model.IsBlocked)</h5>
            <div class="chip @(Model.IsBlocked ? "danger" : "success")">@(Model.IsBlocked ? "Blocked" : "Active")</div>
        </div>
    </div>
</div>
<div class="d-flex flex-column align-items-start justify-content-end mt-5 mx-2">
    <a asp-action="Index" class="btn btn-secondary align-items-center"><h3><i class="bi bi-arrow-return-left me-3"></i>Back to list</h3></a>
</div>
