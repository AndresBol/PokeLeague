@model IEnumerable<PokeLeague.Application.DTOs.UserDTO>

@{
    ViewData["Title"] = "User Maintenance";
}
<div class="d-flex justify-content-between align-items-center">
    <h1>Users</h1>
    @{/*TODO: <a asp-action="Create" class="btn btn-primary" role="button">Create</a>*/}
</div>
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th scope="col">
                #
            </th>
            <th scope="col">
                @Html.DisplayNameFor(model => model.Username)
            </th>
            <th scope="col">
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th scope="col">
                @Html.DisplayNameFor(model => model.Role.Name)
            </th>
            <th scope="col">
                @Html.DisplayNameFor(model => model.IsBlocked)
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr onclick="location.href='@Url.Action("Details", new { id = item.Id })'" style="cursor: pointer;">
            <td scope="row">
                @(Model.ToList().IndexOf(item) + 1)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Username)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Role.Name)
            </td>
            <td>
                <div class="chip @(item.IsBlocked ? "danger" : "success")">@(item.IsBlocked ? "Blocked" : "Active")</div>
            </td>
        </tr>
}
    </tbody>
</table>
