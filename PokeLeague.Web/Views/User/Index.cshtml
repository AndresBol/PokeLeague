@model IEnumerable<PokeLeague.Application.DTOs.UserDTO>

@{
    ViewData["Title"] = "Index";
}
<div class="d-flex justify-content-between align-items-center">
    <h1>Usuarios</h1>
    <a asp-action="Create" class="btn btn-primary" role="button">Agregar</a>
</div>
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th scope="col">
                #
            </th>
            <th scope="col">
                @Html.DisplayNameFor(model => model.Username)
            </th>
            <th scope="col">
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th scope="col">
                @Html.DisplayNameFor(model => model.PasswordHash)
            </th>
            <th scope="col">
                @Html.DisplayNameFor(model => model.IsBlocked)
            </th>
            <th scope="col">
                @Html.DisplayNameFor(model => model.IsActive)
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr onclick="location.href='@Url.Action("Details", new { id = item.Id })'" style="cursor: pointer;">
            <td scope="row">
                @(Model.ToList().IndexOf(item) + 1)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Username)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PasswordHash)
            </td> 
            <td>
                @Html.DisplayFor(modelItem => item.IsBlocked)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsActive)
            </td>
        </tr>
}
    </tbody>
</table>
